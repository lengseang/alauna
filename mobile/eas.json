{
  "cli": {
    "version": ">= 24.11.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "cache": {
        "key": "chiwiwi-preview-cache",
        "customPaths": [
          "~/.gradle/caches"
        ]
      }
    },
    "production": {
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "cache": {
        "key": "chiwiwi-prod-cache",
        "customPaths": [
          "~/.gradle/caches"
        ]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
