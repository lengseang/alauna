{
  "cli": {
    "version": ">= 24.11.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "cache": {
        "key": "alauna-dev-cache",
        "paths": [
          "~/.gradle/caches"
        ]
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "cache": {
        "key": "alauna-preview-cache",
        "paths": [
          "~/.gradle/caches"
        ]
      }
    },
    "production": {
      "distribution": "internal",
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "cache": {
        "key": "alauna-prod-cache",
        "paths": [
          "~/.gradle/caches"
        ]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
