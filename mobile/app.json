{
  "expo": {
    "name": "CHIWIWI",
    "slug": "chiwiwi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0D1C",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chiwiwi.sovereign",
      "backgroundColor": "#0A0D1C"
    },
    "android": {
      "package": "com.chiwiwi.sovereign",
      "versionCode": 1,
      "backgroundColor": "#0A0D1C",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A0D1C"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-file-system",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "llama.rn",
      "./plugins/withGradleSpeed",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF6EA",
          "dark": {
            "image": "./assets/android-icon-foreground.png",
            "backgroundColor": "#0A0D1C"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "CHIWIWI lets you attach photos to a chat. They stay on this phone.",
          "cameraPermission": "CHIWIWI lets you take a photo to attach to a chat. It stays on this phone.",
          "microphonePermission": "CHIWIWI turns your voice into text on this phone. Audio never leaves the device."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CHIWIWI uses Face ID to unlock your private chats."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5a49f586-40aa-4252-bfaf-e6c3c4239303"
      }
    },
    "owner": "lengseang"
  }
}
