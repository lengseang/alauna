{
  "expo": {
    "name": "ALAUNA",
    "slug": "alauna",
    "scheme": "alauna",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#09090C",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alauna.app",
      "backgroundColor": "#09090C"
    },
    "android": {
      "package": "com.alauna.app",
      "versionCode": 1,
      "backgroundColor": "#09090C",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#09090C"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-file-system",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "llama.rn",
      "./plugins/withGradleSpeed",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090C",
          "dark": {
            "image": "./assets/android-icon-foreground.png",
            "backgroundColor": "#09090C"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Alauna lets you share private photos with your companion. All data stays offline on this phone.",
          "cameraPermission": "Alauna lets you take a photo to share with your companion. It stays strictly offline on this phone.",
          "microphonePermission": "Alauna uses your microphone for real-time voice conversations. Audio is processed purely on-device and never leaves the phone."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Alauna uses biometric authentication to protect your private intimate chats."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5a49f586-40aa-4252-bfaf-e6c3c4239303"
      }
    },
    "owner": "lengseang"
  }
}
